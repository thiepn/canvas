{
  "$schema": "node_modules/wrangler/config-schema.json",
  "send_metrics": false,
  "name": "canvas-realtime",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "vars": {
    "ALLOWED_ORIGINS": "http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173",
    "APP_ENV": "production"
  },
  "durable_objects": { "bindings": [{ "name": "CANVAS_ROOM", "class_name": "CanvasRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CanvasRoom"] }]
}
