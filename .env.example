# PUBLIC values: Vite embeds these into browser JavaScript.
# Local development defaults to http://127.0.0.1:8787 when omitted.
VITE_CANVAS_API_URL=http://127.0.0.1:8787
# Production requires your own valid hobby, trial, or commercial tldraw key.
# Hobby keys retain the required watermark. This is a public license key, NOT a secret.
VITE_TLDRAW_LICENSE_KEY=
# GitHub project Pages for thiepn/canvas uses /canvas/. Use / on a custom domain.
VITE_BASE_PATH=/canvas/
