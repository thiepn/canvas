# PUBLIC values: Vite embeds VITE_* variables into browser JavaScript.
# The Supabase URL and publishable key are intentionally public; never place a service-role key here.
# These may be omitted to use the checked-in public project defaults.
VITE_SUPABASE_URL=https://hycegznamzjhwinegaai.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_1rZzRPzfLMaAH5pIgCwIjA_19UPMIsR

# Normal production uses canvas_elements. CI/live/preview tests override this with canvas_ci_elements.
VITE_CANVAS_TABLE=canvas_elements

# GitHub project Pages for thiepn/canvas uses /canvas/. Use / on a custom domain.
VITE_BASE_PATH=/canvas/

