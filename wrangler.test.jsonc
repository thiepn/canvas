{
  "$schema": "node_modules/wrangler/config-schema.json",
  "send_metrics": false,
  "name": "canvas-test",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_ORIGINS": "http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173",
    "APP_ENV": "test",
    "ADMIN_TOKEN": "local-test-only-not-a-production-secret-0123456789"
  },
  "durable_objects": { "bindings": [{ "name": "CANVAS_ROOM", "class_name": "CanvasRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CanvasRoom"] }]
}
