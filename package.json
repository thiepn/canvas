{
  "name": "canvas",
  "version": "1.0.0-rc.2",
  "private": true,
  "description": "One permanent shared infinite sheet of paper.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:live": "playwright test --config playwright.live.config.ts",
    "test:performance": "playwright test --config playwright.performance.config.ts",
    "build": "vite build && node scripts/audit-build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "check": "npm run audit:architecture && npm run lint && npm run typecheck && npm test && npm run build && npm run test:live && npm run test:production",
    "release:verify": "node scripts/release-verify.mjs",
    "test:production": "node scripts/test-production.mjs",
    "source:syntax": "node scripts/check-source.mjs",
    "performance:report": "node scripts/render-performance-report.mjs",
    "audit:architecture": "node scripts/audit-architecture.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@supabase/supabase-js": "2.115.0",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "prettier": "3.7.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.48.1",
    "vite": "8.2.2"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.18"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    }
  }
}
